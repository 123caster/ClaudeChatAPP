{
  "name": "@claude-chat/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "claude:smoke": "tsc -p scripts/tsconfig.json && tsx scripts/claude-smoke.ts",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint src scripts --max-warnings=0",
    "pairing:reset": "tsx scripts/reset-pairing.ts",
    "start": "node dist/server.js",
    "test": "vitest run src",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p scripts/tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.231",
    "@claude-chat/database": "workspace:*",
    "@claude-chat/protocol": "workspace:*",
    "@fastify/websocket": "11.3.0",
    "fastify": "^5.7.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10",
    "ws": "^8.21.3"
  }
}
