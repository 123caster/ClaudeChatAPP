{
  "expo": {
    "name": "ClaudeChatAPP",
    "slug": "claude-chat-app",
    "version": "1.3.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "claudechatapp",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.caster123.claudechatapp",
      "versionCode": 24,
      "edgeToEdgeEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#F5F4EF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#147D75",
          "defaultChannel": "scheduled-results"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "允许 ClaudeChatAPP 读取你选择的图片，用于本次提问。",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false,
            "softwareKeyboardLayoutMode": "resize"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F4EF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "允许 ClaudeChatAPP 使用麦克风，以便用语音输入任务。"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
